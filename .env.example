# Copy to .env and fill ONLY what you use. Never commit .env.

# SQLite database (relative paths resolve against prisma/)
DATABASE_URL="file:./dev.db?connection_limit=1"

# LLM provider keys — set the ones you have; the analyst layer picks providers
# by profile name in config/settings.ts (zero code changes to switch).
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
GEMINI_API_KEY=""

# Analyst on/off (briefs + re-rates). Everything else works without it.
ANALYST_ENABLED="true"

# Phone push via ntfy.sh — pick an unguessable topic, subscribe in the ntfy app.
NTFY_ENABLED="false"
NTFY_URL="https://ntfy.sh"
NTFY_TOPIC=""

# Optional IANA timezone for the scheduler (empty = system local time).
ENGINE_TZ=""
